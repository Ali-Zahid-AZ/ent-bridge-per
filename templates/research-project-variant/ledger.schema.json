{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research Results Ledger",
  "description": "Append-only JSONL results ledger. Every row must be re-derivable from its recorded parameters.",
  "type": "object",
  "required": ["run_id", "timestamp_pkt", "git_commit", "seed"],
  "properties": {
    "run_id": {"type": "string"},
    "timestamp_pkt": {"type": "string", "format": "YYYY-MM-DD HH:MM:SS PKT"},
    "git_commit": {"type": "string"},
    "seed": {"type": "integer"},
    "env_hash": {"type": "string", "description": "Hash of environment (pip freeze / uv lock)"},
    "hardware": {
      "type": "object",
      "properties": {
        "peak_vram_mb": {"type": "integer"},
        "peak_ram_mb": {"type": "integer"},
        "wall_clock_s": {"type": "number"}
      }
    },
    "metrics": {"type": "object", "description": "Experiment-specific metrics"}
  },
  "clause": "SCHEMA FROZEN BEFORE ROWS — every row re-derivable from seed + env_hash + params"
}
